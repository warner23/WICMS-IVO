# ----------------------------------------------------------------------
# WIMedia Storage Protection
# ----------------------------------------------------------------------
# Prevent server-side execution in uploaded media folders.
# Files should be accessed through WIMedia delivery where private/sensitive.
# Public files may still be served statically if permissions allow.
# ----------------------------------------------------------------------

Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|bat|cmd|exe|dll|msi|com|jar)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>